# Quato Environment Configuration
# Copy this file to .env and fill in your actual values

# LLM API Configuration
# OpenAI API key for GPT models
OPENAI_API_KEY=your_openai_api_key_here

# Alternative LLM providers (uncomment if using)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# COHERE_API_KEY=your_cohere_api_key_here

# LLM Model Selection
# Options: gpt-4, gpt-3.5-turbo, claude-2, etc.
LLM_MODEL=gpt-4

# QuantRocket Configuration
# URL of your QuantRocket instance
QUANTROCKET_URL=http://localhost:1969

# QuantRocket API credentials (if required)
# QUANTROCKET_API_KEY=your_quantrocket_api_key_here

# Backtesting Configuration
# Default initial capital for backtests
DEFAULT_INITIAL_CAPITAL=100000

# Default commission rate (as decimal, e.g., 0.001 = 0.1%)
DEFAULT_COMMISSION=0.001

# Default slippage (as decimal)
DEFAULT_SLIPPAGE=0.0005

# Strategy Development Settings
# Maximum number of refinement iterations
MAX_REFINEMENT_ITERATIONS=5

# Target Sharpe ratio for strategy refinement
TARGET_SHARPE_RATIO=2.0

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=quato.log

# Database Configuration (optional, for storing results)
# DATABASE_URL=sqlite:///quato.db
# DATABASE_URL=postgresql://user:password@localhost/quato_db

# Feature Flags
# Enable/disable specific features
ENABLE_HYPOTHESIS_CACHING=true
ENABLE_CODE_VALIDATION=true
ENABLE_AUTOMATED_REFINEMENT=true
