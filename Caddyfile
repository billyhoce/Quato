app.quato.space {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    handle /api/* {
        reverse_proxy quato-backend:8000
    }
    handle /mcp* {
        reverse_proxy quato-backend:8000
    }
    handle /health {
        reverse_proxy quato-backend:8000
    }
    handle {
        root * /srv/frontend
        file_server
    }
}
